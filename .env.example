# AppHub API 环境变量（复制为 apps/api/.env 或在进程环境中设置）
# 不要把真实密钥提交进仓库。

PORT=3000
DB_FILE=data/apphub.sqlite
UPLOAD_DIR=uploads

# 首次启动、且用户表为空时创建的管理员；已有用户时不会覆盖密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 生产环境务必修改
JWT_SECRET=apphub-dev-secret

# v3 开放注册：1 开启（默认），0 / false / off / no 关闭
REGISTER_ENABLED=1

# 存储：local（默认）或 s3
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=apphub
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
