# AppHub 环境变量示例。复制后按需修改，不要提交真实密钥。
#
# 本地 `pnpm dev` / `pnpm start` 不会自动加载 .env（API 未接入 dotenv）。
# 需要先导出，例如：set -a && source .env && set +a
#
# Docker Compose 会读取项目根目录的 .env 做 ${VAR} 替换，但只有
# docker-compose.yml 里 environment 列出的变量会进入容器。
#
# 生产环境必须更换 ADMIN_PASSWORD 与 JWT_SECRET。
# 管理员只在用户表为空时创建一次；之后再改这两项不会更新已有账号。

PORT=3000
DB_FILE=data/apphub.sqlite
UPLOAD_DIR=uploads

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# 开放注册。apps/api/src/config.ts 会读取该变量，默认开启。
# 设为 0 / false / off / no 则关闭：登录页不显示注册入口，
# POST /api/auth/register 返回 403。
REGISTER_ENABLED=1

STORAGE_DRIVER=local

# 仅当 STORAGE_DRIVER=s3 时由 StorageService 读取。local 模式忽略这些值。
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=apphub
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PUBLIC_BASE_URL=https://cdn.example.com
